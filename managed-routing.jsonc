{
  "$schema": "https://opencode.ai/config.json",
  // Install as /Library/Application Support/opencode/opencode.jsonc.
  // System settings outrank project and user settings. Update this file and
  // reinstall it whenever changing the approved routing table.
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",
  "compaction": {
    "auto": true,
    "keep": { "tokens": 12000 },
    "buffer": "25%"
  },
  "experimental": { "subagent_depth": 1 },
  "agents": {
    "build": { "model": "opencode-go/deepseek-v4.1-flash", "disabled": false },
    "plan": { "model": "opencode-go/deepseek-v4.1-flash", "disabled": false },
    "explore": { "model": "opencode-go/gpt-6-luna#low", "disabled": false },
    "general": { "model": "opencode-go/deepseek-v4.1-flash", "disabled": false },
    "task-reviewer": {
      "mode": "subagent",
      "model": "openai/gpt-6-luna#medium",
      "disabled": false,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse*", "effect": "allow" }
      ]
    },
    "reviewer": {
      "mode": "subagent",
      "model": "openai/gpt-6.1-sol#high",
      "disabled": false,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "git diff*", "effect": "allow" },
        { "action": "shell", "resource": "git show*", "effect": "allow" },
        { "action": "shell", "resource": "git log*", "effect": "allow" },
        { "action": "shell", "resource": "git status*", "effect": "allow" },
        { "action": "shell", "resource": "git rev-parse*", "effect": "allow" }
      ]
    },
    "architect": {
      "mode": "subagent",
      "model": "opencode-go/kimi-k3.1-pro#high",
      "disabled": false
    },
    // Delivery lifecycle owner. Model pinned here so /deliver uses the mid tier
    // even when the session was started on an escalated model.
    "orchestrator": {
      "mode": "primary",
      "model": "opencode-go/deepseek-v4.1-flash",
      "disabled": false
    },
    // Independent verification. Runs checks; never edits product code.
    "qa-engineer": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4.1-flash",
      "disabled": false
    }
  },
  "worktree": {
    "directory": "../.worktrees"
  }
}
